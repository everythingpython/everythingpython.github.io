# Copy this file to .env. Never commit the real .env file.

# Required only when recording/uploading audio for Sarvam transcription.
SARVAM_API_KEY=
# Use translate to normalize Indic-language or code-mixed speech to English.
SARVAM_STT_MODE=translate

# Required for LiteLLM's structured expense extraction through Groq.
GROQ_API_KEY=
# Optional: leave this at the tested default unless you deliberately change models.
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Required only for the Langfuse cloud trace dashboard.
# Create a project at https://cloud.langfuse.com, then use the project's keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud default. Change only if your project is in another Langfuse region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
