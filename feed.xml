---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.heading | xml_escape }}</title>
    <description>{{ site.content | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml"/>

    {% assign all_entries = site.posts | concat: site.notes %}
    {% assign sorted_entries = all_entries | sort: "date" | reverse %}
    {% assign latest_entry = sorted_entries | first %}

    <pubDate>{{ latest_entry.date | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ latest_entry.date | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    
    {% for entry in sorted_entries limit:20 %}
      <item>
        <title>{{ entry.title | xml_escape }}</title>
        <description>{{ entry.excerpt | strip_html | xml_escape }}</description>
        <pubDate>{{ entry.date | date_to_rfc822 }}</pubDate>
        <link>{{ entry.url | prepend: site.baseurl | prepend: site.url }}</link>
        <guid isPermaLink="true">{{ entry.url | prepend: site.baseurl | prepend: site.url }}</guid>
        {% for tag in entry.tags %}
        <category>{{ tag | xml_escape }}</category>
        {% endfor %}
        {% for cat in entry.categories %}
        <category>{{ cat | xml_escape }}</category>
        {% endfor %}
      </item>
    {% endfor %}
  </channel>
</rss>
